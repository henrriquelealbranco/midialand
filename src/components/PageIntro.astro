---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="page-intro container">
  <p class="eyebrow">
    <span class="dot"></span>
    {eyebrow}
  </p>
  <div class="intro-grid">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
  </div>
</section>
