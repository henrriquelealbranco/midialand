---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
const formats = [
  {
    title: 'TV do Ônibus',
    image: 'onibus',
    alt: 'TV com publicidade no interior de um ônibus com passageiros',
    text: 'Telas a bordo dos ônibus integram informação, entretenimento e mensagens publicitárias. Uma forma de acompanhar os deslocamentos cotidianos em Curitiba.',
    interest: 'Mídia no transporte',
  },
  {
    title: 'TVs Estações',
    image: 'estacoes',
    alt: 'Telas suspensas sobre a plataforma de um terminal de ônibus',
    text: 'Nos terminais, as telas fazem parte dos momentos de espera e conexão entre linhas. O conteúdo audiovisual insere a marca no ambiente de circulação.',
    interest: 'Mídia no transporte',
  },
  {
    title: 'MUBs Estações',
    image: 'mobiliario',
    alt: 'Equipamento vertical de mídia digital em plataforma de terminal',
    text: 'O mobiliário de mídia aproxima a mensagem do percurso dos passageiros. Uma presença visual que complementa as telas e outros formatos do circuito.',
    interest: 'Mobiliário urbano',
  },
  {
    title: 'Ativações nos terminais',
    image: 'ativacao',
    alt: 'Experiência de marca com estrutura interativa instalada em um terminal',
    text: 'Experiências presenciais convidam as pessoas a interagir com a marca. Cada ação parte de uma ideia e depende da avaliação do espaço e das condições de realização.',
    interest: 'Projetos e ativações',
  },
];
---

<Layout
  title="TV do Ônibus e mídia nos terminais de Curitiba"
  description="Conheça a TV do Ônibus, TVs Estações, MUBs e ativações nos terminais. Soluções Midialand para estar nos trajetos do transporte coletivo de Curitiba."
>
  <PageIntro
    eyebrow="Transporte coletivo · Curitiba"
    title="Sua marca vai junto."
    description="Entre partidas, encontros e novos destinos, existe espaço para uma boa mensagem. Conheça os formatos de mídia no transporte coletivo."
  />
  <figure class="transport-hero container">
    <Photo
      name="embarque"
      alt="Passageiros em um ônibus com tela publicitária à frente"
      priority
      sizes="100vw"
    />
  </figure>
  <section class="section container transport-intro">
    <h2>
      O caminho também
      <br />é um lugar de encontro.
    </h2>
    <p>
      A mídia embarcada e as estruturas nos terminais se conectam aos trajetos de quem vive a
      cidade. Planeje com a equipe uma combinação de formatos para o objetivo da sua marca,
      considerando circuitos, conteúdo e período da campanha.
    </p>
  </section>
  <section class="paper section">
    <div class="container">
      <p class="eyebrow">
        <span class="dot"></span>Ônibus, estações e experiências
      </p>
      <h2 style="margin-bottom:38px">Conexões em diferentes momentos.</h2>
      <div class="transport-options">
        {formats.map((format) => (
          <article class="transport-option">
            <Photo name={format.image} alt={format.alt} />
            <h3>{format.title}</h3>
            <p>{format.text}</p>
            <a class="text-link" href={`/contato/?solucao=${encodeURIComponent(format.interest)}`}>
              Conversar sobre este formato
              <Arrow direction="up" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section-small container">
    <div class="download-band">
      <div>
        <h2>Explore os formatos do circuito.</h2>
        <p>
          Material de referência sobre ônibus e estações. Consulte a equipe para informações atuais.
        </p>
      </div>
      <a
        class="button button-outline"
        href="/downloads/Midia_Kit_onibus_metro_estacoes.pdf"
        download
      >
        Baixar mídia kit · PDF
        <Arrow direction="down" />
      </a>
    </div>
  </section>
</Layout>
