---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import CitySelector from '../components/CitySelector.astro';
import Gallery from '../components/Gallery.astro';
import { solutions, articles } from '../data/site';
---

<Layout
  title="Mídia exterior que conecta marcas e cidades"
  description="Grandes formatos, painéis digitais, transporte coletivo e ativações. Conheça a Midialand e planeje sua próxima campanha de mídia exterior."
>
  <section class="hero container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="dot"></span>Mídia exterior. Conexões reais.
        </p>
        <h1>
          Sua marca no caminho de milhares de <em>histórias.</em>
        </h1>
        <p class="lead">
          Mídia exterior, painéis digitais e experiências urbanas para aproximar sua marca do
          público.
        </p>
        <div class="actions">
          <a href="/contato/" class="button">
            Planejar minha campanha
            <Arrow direction="up" />
          </a>
          <a href="/produtos/" class="text-link">
            Explorar soluções
            <Arrow />
          </a>
        </div>
      </div>
      <figure class="hero-visual">
        <Photo
          name="cidade"
          alt="Painéis de mídia exterior e uma fachada colorida integrados à paisagem de uma avenida"
          priority
          sizes="(max-width: 600px) 100vw, 50vw"
          position="53% center"
        />
        <span class="hero-stamp" aria-hidden="true">
          <Arrow direction="up" />
        </span>
        <figcaption class="hero-caption">
          <span>A vida acontece lá fora.</span>
          <span>OOH + DOOH</span>
        </figcaption>
      </figure>
    </div>
    <div class="presence-strip">
      <p>Presença urbana. Diferentes caminhos para a sua marca.</p>
      <div class="presence-places">
        <span>Curitiba</span>
        <span>São José dos Pinhais</span>
        <span>Porto Alegre</span>
      </div>
      <a class="text-link" href="/onde-estamos/">
        Conheça as praças
        <Arrow direction="up" />
      </a>
    </div>
  </section>
  <section class="section container" aria-labelledby="solucoes-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span class="dot"></span>Um mundo de possibilidades
        </p>
        <h2 id="solucoes-heading">
          A cidade é o meio.
          <br />
          Sua marca, a mensagem.
        </h2>
      </div>
      <a href="/produtos/" class="text-link">
        Todas as soluções
        <Arrow direction="up" />
      </a>
    </div>
    <div class="solutions-editorial">
      <a class="solution-feature" href="/produtos/#grandes-formatos">
        <Photo name="estatico" alt={solutions[0].alt} />
        <div class="feature-copy">
          <div>
            <h3>Grandes formatos</h3>
            <p>Presença que muda a paisagem.</p>
          </div>
          <span class="round-link">
            <Arrow direction="up" />
          </span>
        </div>
      </a>
      <div class="solution-list">
        {solutions.slice(1).map((solution) => (
          <a class="solution-row" href={`/produtos/#${solution.id}`}>
            <Photo name={solution.image} alt={solution.alt} sizes="120px" />
            <div>
              <h3>{solution.title}</h3>
              <p>{solution.short}</p>
            </div>
            <Arrow direction="up" />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section paper">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="dot"></span>Presença que conecta
          </p>
          <h2>
            Onde sua campanha
            <br />
            encontra o público.
          </h2>
        </div>
        <p>
          Cada cidade tem seu ritmo.
          <br />
          Encontre os formatos que fazem sentido para a sua campanha.
        </p>
      </div>
      <CitySelector />
      <p class="coverage-note">
        A atuação da Midialand também inclui a Região Metropolitana de Curitiba, o litoral e o
        interior do Paraná. Converse com a equipe sobre as possibilidades em cada região.
      </p>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span class="dot"></span>Nas ruas, na vida
        </p>
        <h2>
          Mídia que faz
          <br />
          parte da cidade.
        </h2>
      </div>
      <a class="text-link" href="/cases/">
        Explorar a galeria
        <Arrow direction="up" />
      </a>
    </div>
    <Gallery limit={6} />
  </section>
  <section class="transport-feature">
    <Photo
      name="onibus"
      alt="Passageiro no interior de um ônibus ao lado de uma TV com publicidade"
      sizes="(max-width: 600px) 100vw, 55vw"
    />
    <div class="transport-copy">
      <p class="eyebrow">TV do Ônibus</p>
      <h2>
        Junto das pessoas.
        <br />
        Em cada trajeto.
      </h2>
      <p>
        Na ida ao trabalho, na volta para casa, entre um compromisso e outro. Sua marca pode fazer
        parte das histórias que circulam pelo transporte coletivo de Curitiba.
      </p>
      <a href="/tv-do-onibus/" class="button button-white">
        Conhecer a TV do Ônibus
        <Arrow direction="up" />
      </a>
    </div>
  </section>
  <section class="section container urban-section">
    <div class="urban-copy">
      <p class="eyebrow">
        <span class="dot"></span>Além da mídia
      </p>
      <h2>
        Boas ideias também
        <br />
        transformam lugares.
      </h2>
      <p>
        Olhar para a cidade é olhar para quem vive nela. A Midialand apresenta o Jardim Pugsley como
        uma iniciativa que une convivência, áreas verdes e cuidado com o espaço urbano.
      </p>
      <p>
        Em Porto Alegre, o hackathon com a Unisinos abriu espaço para novas ideias de
        sustentabilidade. O relato do encontro prevê a execução do projeto vencedor.
      </p>
      <a class="text-link" href="/sobre-nos/#cidade">
        Conheça essas iniciativas
        <Arrow direction="up" />
      </a>
    </div>
    <figure class="urban-photo">
      <Photo name="hackathon" alt="Participantes reunidos no hackathon com a Unisinos" />
      <figcaption>Registro do hackathon com a Unisinos · publicação de maio de 2026.</figcaption>
    </figure>
  </section>
  <section class="section paper">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="dot"></span>Da ideia à presença
          </p>
          <h2>
            Seu próximo movimento
            <br />
            começa com uma conversa.
          </h2>
        </div>
      </div>
      <ol class="steps">
        <li>
          <span class="step-number">01</span>
          <h3>Conte seu objetivo</h3>
          <p>Compartilhe o que sua marca quer comunicar e em quais cidades deseja estar.</p>
        </li>
        <li>
          <span class="step-number">02</span>
          <h3>Defina os formatos com nossa equipe</h3>
          <p>Converse sobre os meios e espaços que combinam com o planejamento da campanha.</p>
        </li>
        <li>
          <span class="step-number">03</span>
          <h3>Leve sua marca para a cidade</h3>
          <p>Com o plano definido, alinhe as peças e os detalhes da veiculação com a Midialand.</p>
        </li>
      </ol>
    </div>
  </section>
  <section class="section-small container">
    <div class="download-band">
      <div>
        <h2>Conheça as possibilidades de mídia.</h2>
        <p>
          Mídia kit de referência. Formatos, condições e disponibilidade devem ser confirmados com a
          equipe.
        </p>
      </div>
      <a class="button button-outline" href="/downloads/midiakit.pdf" download>
        Baixar mídia kit <span class="file-label">PDF</span>
        <Arrow direction="down" />
      </a>
    </div>
    <a class="text-link" style="margin-top:22px" href="/blog/">
      Da cidade para o nosso conteúdo: {articles.length} leituras para explorar
      <Arrow />
    </a>
  </section>
</Layout>
