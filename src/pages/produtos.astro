---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import { solutions } from '../data/site';
---

<Layout
  title="Soluções de mídia OOH e DOOH"
  description="Explore painéis estáticos e digitais, mídia no transporte coletivo, mobiliário urbano e ativações da Midialand. Encontre um formato para sua campanha."
>
  <PageIntro
    eyebrow="Soluções para a sua marca"
    title="Diferentes formatos. A mesma conexão."
    description="Da escala de um grande painel à proximidade de uma experiência presencial. Explore maneiras de participar do cotidiano das pessoas."
  />
  <div class="container">
    <nav class="product-jump" aria-label="Formatos de mídia">
      {solutions.map((solution) => (
        <a href={`#${solution.id}`}>{solution.title}</a>
      ))}
    </nav>
    {solutions.map((solution) => (
      <section class="product-detail" id={solution.id}>
        <figure class="product-image">
          <Photo name={solution.image} alt={solution.alt} />
        </figure>
        <div>
          <p class="eyebrow">
            <span class="dot"></span>
            {solution.tag}
          </p>
          <h2>{solution.title}</h2>
          <p class="description">{solution.description}</p>
          <h3 class="small-label">Possibilidades de aplicação</h3>
          <ul class="applications">
            {solution.applications.map((application) => (
              <li>{application}</li>
            ))}
          </ul>
          <p class="product-coverage">
            <strong>Onde:</strong> {solution.coverage}
          </p>
          <div class="actions">
            <a class="button" href={`/contato/?solucao=${encodeURIComponent(solution.title)}`}>
              Planejar com este formato
              <Arrow direction="up" />
            </a>
            {solution.id === 'transporte-coletivo' ? (
              <a class="text-link" href="/tv-do-onibus/">
                Conhecer os circuitos
                <Arrow />
              </a>
            ) : (
              <a class="text-link" href="/downloads/midiakit.pdf" download>
                Mídia kit · PDF
                <Arrow direction="down" />
              </a>
            )}
          </div>
        </div>
      </section>
    ))}
  </div>
  <section class="section-small container">
    <p class="fine-print">
      Os materiais para download são referências do acervo da Midialand. Consulte a equipe para
      confirmar os pontos, as especificações e a disponibilidade para a sua campanha.
    </p>
  </section>
</Layout>
